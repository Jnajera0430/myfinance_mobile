{
  "expo": {
    "name": "Mifinanzas",
    "slug": "mifinanzas-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f8fafc"
    },
    "scheme": "mifinanzas",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mifinanzas.app",
      "infoPlist": {
        "NSCameraUsageDescription": "La cámara se usa para escanear el código QR de tus facturas.",
        "NSPhotoLibraryUsageDescription": "Accedemos a tus imágenes para leer códigos QR de facturas guardadas."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.mifinanzas.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "mifinanzas"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Permitimos el uso de la cámara para escanear códigos QR de facturas.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Elegimos una imagen de tu galería para leer el código QR de la factura."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#6366f1"
        }
      ]
    ]
  }
}
