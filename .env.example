# URL del backend GraphQL usada por la app.
# Si la dejas vacia, la app resuelve automaticamente la IP del host de Expo:
#   - Android emulador  -> http://10.0.2.2:3000/graphql
#   - iOS simulador     -> http://localhost:3000/graphql
#   - Dispositivo real  -> http://<IP-LAN-del-PC>:3000/graphql
#
# Ejemplo para dispositivo fisico (reemplaza por la IP de tu PC):
# EXPO_PUBLIC_API_URL=http://192.168.1.20:3000/graphql
EXPO_PUBLIC_API_URL=
